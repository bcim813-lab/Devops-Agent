{
  "name": "crm-devops-agents",
  "version": "1.0.0",
  "description": "Event-driven automation platform for CRM DevOps pipeline",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "test": "jest --runInBand",
    "test:unit": "jest --runInBand --testPathPattern=tests/unit",
    "test:property": "jest --runInBand --testPathPattern=tests/property",
    "test:integration": "jest --runInBand --testPathPattern=tests/integration",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "dependencies": {
    "uuid": "9.0.1"
  },
  "devDependencies": {
    "@types/jest": "29.5.12",
    "@types/node": "20.12.12",
    "@types/uuid": "9.0.8",
    "fast-check": "3.19.0",
    "jest": "29.7.0",
    "ts-jest": "29.1.4",
    "typescript": "5.4.5"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.ts",
      "**/tests/**/*.property.test.ts",
      "**/tests/**/*.integration.test.ts"
    ],
    "moduleFileExtensions": ["ts", "js", "json"],
    "testTimeout": 30000,
    "coverageDirectory": "coverage",
    "collectCoverageFrom": [
      "src/**/*.ts",
      "!src/**/*.d.ts"
    ]
  }
}
