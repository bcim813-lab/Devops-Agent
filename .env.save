GitHub
GITHUB_WEBHOOK_SECRET=test-secret
GITHUB_REPOS=my-org/my-repo

# Jenkins
JENKINS_BASE_URL=http://localhost:8080
JENKINS_API_TOKEN=test-token
JENKINS_JOBS=my-org/my-repo:DeployJob

# Kubernetes
KUBECONFIG=
K8S_NAMESPACES=default

# PagerDuty
PAGERDUTY_API_TOKEN=test-pd-token
PD_SERVICE_RUNBOOK_MAP=frontend:FrontendRunbook

# Slack
SLACK_BOT_TOKEN=xoxb-test-token
SLACK_CHANNELS=deploy:#deployments;incident:#incidents
SLACK_ON_CALL_HANDLES=frontend:@miguel

# Pipeline
PIPELINE_MAX_DURATION_SECONDS=1800
PIPELINE_ROLLOUT_TIMEOUT_SECONDS=600
